# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings → API in the Supabase dashboard). .env.local is
# git-ignored — these are never committed.

# Safe to expose to the browser (used by the client-side Supabase SDK).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses Row Level Security,
# so it must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. Leave as "mock" to develop the whole app without an API key —
# the mock provider simulates streaming, task parsing, briefings, and
# suggestions. Safe to expose to the browser: it only names which provider
# to call, never a credential. Set to "anthropic" to use real Claude
# responses for free-form "ask NEXUS" questions and note actions (task/event
# extraction and calendar planning stay on the deterministic mock engine —
# they produce structured data the app acts on directly, not prose).
NEXT_PUBLIC_AI_PROVIDER=mock

# Required only when NEXT_PUBLIC_AI_PROVIDER=anthropic. Server-only — never
# prefix with NEXT_PUBLIC_. Get a key at https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional — defaults to claude-haiku-4-5 (fast, inexpensive). Use
# claude-sonnet-5 for higher-quality answers at a higher cost per request.
# ANTHROPIC_MODEL=claude-haiku-4-5
